# Local PostgreSQL only. Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avenova_workspace?schema=public"

# Required by Better Auth. Generate a unique secret for each environment.
# Never commit the real value.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
